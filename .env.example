# Copy this file to .env and fill in what you need.

# ── LLM (pick one) ───────────────────────────────────────────────
# Groq (free, fast): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model
# GROQ_MODEL=openai/gpt-oss-120b

# "groq" or "ollama". Defaults to groq when GROQ_API_KEY is set.
# For fully local use, install Ollama (https://ollama.com) and run: ollama pull mistral
# LLM_MODE=ollama

# ── Optional ─────────────────────────────────────────────────────
# Birth-city lookup works without this (shared default account).
# A free personal account avoids rate limits: https://www.geonames.org/login
# GEONAMES_USERNAME=
